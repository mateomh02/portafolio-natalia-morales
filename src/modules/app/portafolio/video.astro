---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const logo = (file: string) => `${base}/brand/${file}`;

// Acepta URL completa (shorts, watch, youtu.be) o solo el ID
const getId = (url: string) =>
  url.match(/(?:shorts\/|embed\/|v=|youtu\.be\/)([\w-]{11})/)?.[1] ?? url;

const embed = (url: string) =>
  `https://www.youtube-nocookie.com/embed/${getId(url)}?rel=0&playsinline=1&modestbranding=1`;

// Un video por marca. El orden del arreglo es el orden en pantalla.
const videos = [
  {
    brand: "CeraVe",
    logo: logo("cerave.png"),
    url: "https://www.youtube.com/shorts/IvDO4qFiQyI",
  },
  {
    brand: "Neutrogena",
    logo: logo("neutrogena.png"),
    url: "https://www.youtube.com/shorts/BBBBBBBBBBB",
  },
  {
    brand: "L'Oréal",
    logo: logo("loreal.png"),
    url: "https://www.youtube.com/shorts/CCCCCCCCCCC",
  },
  {
    brand: "Rappi",
    logo: logo("rappi.png"),
    url: "https://www.youtube.com/shorts/DDDDDDDDDDD",
  },
].map((v) => ({ ...v, src: embed(v.url) }));
---

<section class="bg-white py-6">
  <div class="mx-auto w-[85%] max-w-360">
    <header class="mb-12 text-center">
      <p
        class="font-secondary text-sm uppercase tracking-[0.25em] text-primary-dark"
      >
        Colaboraciones
      </p>
      <h2 class="font-primary text-5xl font-medium text-text-dark lg:text-7xl">
        Videos con <em class="text-primary">marcas</em>
      </h2>
    </header>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4 lg:gap-5">
      {
        videos.map((v) => (
          <article class="flex flex-col gap-3 rounded-3xl bg-primary-soft p-3">
            <div class="flex h-14 items-center justify-center rounded-full bg-white px-5">
              <img
                src={v.logo}
                alt={`Logo de ${v.brand}`}
                loading="lazy"
                class="max-h-8 w-auto max-w-full object-contain"
              />
            </div>
            <div class="aspect-9/16 overflow-hidden rounded-2xl bg-white">
              <iframe
                data-src={v.src}
                title={`Video con ${v.brand}`}
                class="h-full w-full"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
