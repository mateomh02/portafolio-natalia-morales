---
import { WHATSAPP_URL } from "@/modules/core/utils/contact";

// src/components/Hero.astro
const base = import.meta.env.BASE_URL;
---

<section
  id="inicio"
  class="relative isolate h-svh min-h-[520px] w-full overflow-hidden"
>
  <!-- Imagen de respaldo: se ve mientras carga el video, si falla, o con "reducir movimiento" -->
  <img
    src={`${base}/banner.png`}
    alt="Natalia Morales maquillando a una novia en su estudio"
    class="hero-media absolute inset-0 -z-20 h-full w-full object-cover object-[60%_30%] brightness-[0.25]"
    fetchpriority="high"
    loading="eager"
    decoding="async"
  />

  <!-- Video de fondo -->
  <div>
    <video
      data-hero-video
      class="hero-media absolute inset-0 -z-20 h-full w-full object-cover object-[100%_30%] sm:object-[60%_30%] brightness-[0.25] motion-reduce:hidden"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src={`${base}/video-pagina-natalia.mp4`} type="video/mp4" />
    </video>
  </div>

  <div
    class="mx-auto flex h-full items-end pr-[6vw] pb-[10vh] w-[85%] max-w-360"
  >
    <div class="max-w-xl text-white">
      <p
        class="reveal font-secondary mb-3 text-sm uppercase tracking-[0.25em] text-white"
        style="--d:0.1s"
      >
        Maquillaje &amp; creación de contenido
      </p>
      <h1
        class="reveal font-primary text-5xl leading-[1.05] sm:text-6xl lg:text-7xl"
        style="--d:0.25s"
      >
        Realzo tu belleza, <em class="text-white">conecto con tu marca</em>
      </h1>
      <div class="reveal mt-8 flex flex-wrap gap-3" style="--d:0.55s">
        <a
          href={WHATSAPP_URL}
          class="rounded-full text-white p-2 sm:px-8 sm:py-3.5 font-medium bg-primary-dark transition hover:-translate-y-0.5 h-fit"
          target="_blank"
        >
          Reservar cita
        </a>
        <a
          href={`${base}/#portfolio`}
          class="rounded-full border border-white/70 p-2 sm:px-8 sm:py-3.5 text-white transition hover:bg-white/15"
        >
          Ver trabajos
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-media {
    animation: zoom 1.8s ease-out both;
  }
  .reveal {
    animation: rise 0.8s ease-out both;
    animation-delay: var(--d, 0s);
  }

  @keyframes zoom {
    from {
      transform: scale(1.1);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media,
    .reveal {
      animation: none;
    }
  }
</style>

<script>
  // Pausa el video cuando el hero sale de pantalla (ahorra batería y datos)
  const init = () => {
    const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
    if (!video || video.dataset.init) return;
    video.dataset.init = "1";

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }).observe(video);
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
