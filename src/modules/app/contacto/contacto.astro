---
import { WHATSAPP_URL } from "@/modules/core/utils/contact";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Cambia estos datos por los reales
const photo = `${base}/foto-contactame.jpg`;

const instagram = {
  href: "https://www.instagram.com/naty.morofficial/",
  handle: "@naty.morofficial",
};
const tiktok = {
  href: "https://www.tiktok.com/@naty.morofficial",
  handle: "naty.morofficial",
};
---

<section id="contacto" class="bg-primary-soft py-[7vh]">
  <div
    class="mx-auto grid w-[85%] max-w-360 items-center gap-12 md:grid-cols-2 md:gap-16"
  >
    <!-- Foto circular con iconos flotando -->
    <div class="relative mx-auto aspect-square w-full max-w-md">
      <div class="absolute inset-0 rounded-full bg-white"></div>
      <div
        class="absolute inset-5 overflow-hidden rounded-full border-4 border-white shadow-[0_25px_60px_rgb(61_16_48/0.18)]"
      >
        <img
          src={photo}
          alt="Natalia Morales, maquilladora profesional"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-top"
        />
      </div>

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp"
        class="flex justify-center absolute top-6 right-0 h-14 w-14 place-items-center rounded-full bg-primary-dark text-white shadow-lg transition hover:-translate-y-1 hover:bg-text-dark"
      >
        <svg
          stroke="currentColor"
          fill="currentColor"
          stroke-width="0"
          viewBox="0 0 448 512"
          height="200px"
          width="200px"
          xmlns="http://www.w3.org/2000/svg"
          style="
    fill: white;
    width: 31px;
"
          ><path
            d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
          ></path></svg
        >
      </a>
      <a
        href={instagram.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="absolute bottom-16 -left-2 grid h-14 w-14 place-items-center rounded-full bg-white text-primary-dark shadow-lg transition hover:-translate-y-1"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-7 w-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"
          ></circle>
        </svg>
      </a>
      <a
        href={tiktok.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="TikTok"
        class="absolute right-6 bottom-2 grid h-14 w-14 place-items-center rounded-full bg-white text-primary-dark shadow-lg transition hover:-translate-y-1"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-6 w-6"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
          ></path>
        </svg>
      </a>
    </div>

    <!-- Texto -->
    <div class="text-center md:text-left">
      <p
        class="font-secondary text-sm font-medium uppercase tracking-[0.25em] text-primary-dark"
      >
        Contacto
      </p>
      <h2
        class="font-secondary mt-3 text-4xl font-semibold leading-[1.1] tracking-tight text-text-dark lg:text-6xl"
      >
        Hablemos de tu <span class="text-primary">look</span>
      </h2>
      <p
        class="font-secondary mx-auto mt-5 max-w-md text-base leading-relaxed text-text md:mx-0 lg:text-lg"
      >
        Cuéntame qué evento tienes y te respondo con disponibilidad y precios.
      </p>

      <div
        class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap md:justify-start sm:justify-center"
      >
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="font-secondary inline-flex items-center justify-center gap-2 rounded-full bg-primary-dark px-8 py-4 font-medium text-white transition hover:-translate-y-0.5 hover:bg-text-dark"
        >
          Escribir por WhatsApp
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div
        class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center md:justify-start"
      >
        <a
          href={instagram.href}
          target="_blank"
          rel="noopener noreferrer"
          class="font-secondary inline-flex items-center justify-center gap-2 rounded-full border border-primary-light bg-white px-6 py-3 text-sm text-text-dark transition hover:border-primary-dark transition: all 0.5s ease"
        >
          Instagram <span class="text-primary-dark">{instagram.handle}</span>
        </a>
        <a
          href={tiktok.href}
          target="_blank"
          rel="noopener noreferrer"
          class="font-secondary inline-flex items-center justify-center gap-2 rounded-full border border-primary-light bg-white px-6 py-3 text-sm text-text-dark transition hover:border-primary-dark transition: all 0.5s ease"
        >
          TikTok <span class="text-primary-dark">{tiktok.handle}</span>
        </a>
      </div>
    </div>
  </div>
</section>
